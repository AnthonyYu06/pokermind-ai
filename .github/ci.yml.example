name: Local correctness and dependency gates
on: [push, pull_request]
permissions:
  contents: read
jobs:
  fast:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.13'
      - uses: actions/setup-node@v4
        with:
          node-version: '26.7.0'
          cache: npm
          cache-dependency-path: apps/web/package-lock.json
      - run: python -m pip install -r requirements.lock pip-audit==2.10.0
      - run: python -m pytest -q
      - run: npm ci && npm run build && npm audit --audit-level=moderate
        working-directory: apps/web
      - run: pip-audit -r requirements.lock --strict
      - run: python scripts/security_check.py
  cloud-contract:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - run: python -m pip install -r requirements.lock boto3==1.36.2 databricks-sdk==0.49.0
      - run: python -m pytest -q tests/cloud tests/unit/test_cloud_policy.py
      - run: python scripts/cloud_preflight.py
  browser:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.13'
      - uses: actions/setup-node@v4
        with:
          node-version: '26.7.0'
      - run: python -m pip install -r requirements.lock
      - run: npm ci && npm run build && npx playwright install --with-deps chromium
        working-directory: apps/web
      - run: npx playwright test
        working-directory: apps/web
        env:
          POKERMIND_TEST_PYTHON: python
